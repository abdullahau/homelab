services:
  nocodb:
    image: nocodb/nocodb:latest
    depends_on:
      nocodb_db:
        condition: service_healthy
      redis:
        condition: service_healthy
    environment:
      NC_DB: "pg://nocodb_db:5432?u=postgres&p=password&d=root_db"
      NC_PUBLIC_URL: "https://nocodb.qubes-marketing.xyz"
      NC_AUTH_JWT_SECRET: ${NC_AUTH_JWT_SECRET}
      NUXT_PUBLIC_NC_BACKEND_URL: "https://nocodb.qubes-marketing.xyz"
      NC_SMTP_FROM: "nocodbnotification@gmail.com"
      NC_SMTP_HOST: "smtp.gmail.com"
      NC_SMTP_PORT: "465"
      NC_SMTP_USERNAME: "nocodbnotification@gmail.com"
      NC_SMTP_PASSWORD: "${NC_SMTP_PASSWORD}"
      NC_SMTP_SECURE: "true"
      NC_ATTACHMENT_RETENTION_DAYS: 5
      DB_QUERY_LIMIT_MAX: 10000000
      DB_QUERY_LIMIT_DEFAULT: 10000000
      NC_REQUEST_BODY_SIZE: 2000000000
      NC_ATTACHMENT_FIELD_SIZE: 2000000000
      NC_ALLOW_LOCAL_HOOKS: true
      NC_ADMIN_EMAIL: info@qubes.ae
      NC_ADMIN_PASSWORD: ${NC_ADMIN_PASSWORD}
      NODE_ENV: production
      NC_DISABLE_PG_DATA_REFLECTION: "false"
      NC_REDIS_URL: "redis://redis:6379"
      NC_DISABLE_SUPPORT_CHAT: "true"
      NC_DISABLE_TELE: "true"
    ports:
      - "8080"  
    restart: always
    volumes:
      - ./data/nocodb:/usr/app/data
    deploy:
      # scale with: docker compose up --build -d --scale nocodb=3
      replicas: 1
      resources:
        reservations:
          memory: 200M

  nginx-lb:
    image: nginx:alpine
    container_name: nocodb-lb
    ports:
      - "8080:80"
    volumes:
      - ./nginx.conf:/etc/nginx/nginx.conf:ro
    depends_on:
      - nocodb
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:80/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 15s
    restart: always

  nocodb_db:
    image: postgres:16.6
    container_name: nocodb_postgres
    environment:
      POSTGRES_DB: root_db
      POSTGRES_PASSWORD: password
      POSTGRES_USER: postgres
    ports:
      - "5432:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 10s
      timeout: 5s
      retries: 5
    restart: always
    volumes:
      - ./data/nocodb_db:/var/lib/postgresql/data

  redis:
    image: redis:latest
    container_name: redis
    restart: unless-stopped
    command: redis-server --appendonly yes --maxmemory 512mb --maxmemory-policy allkeys-lru --replica-read-only no
    environment:
      - REDIS_HOST=redis
      - REDIS_PORT=6379
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 3
    volumes:
      - ./data/redis:/data
    deploy:
      resources:
        reservations:
          memory: 256M

  pyworker:
    build:
      context: .
      dockerfile: Dockerfile.pyworker
    image: qubes-pyworker:latest
    container_name: pyworker
    restart: always
    environment:
      - TZ=Asia/Dubai
      - personal_api=${personal_api}
      - office_api=${office_api}
      - deepseek_api=${deepseek_api}
      - app_password=${app_password}
      - email_address=${email_address}      
    volumes:
      - ./scripts:/qubes/scripts:ro
      - ./downloads:/qubes/downloads
      - ./tmp:/qubes/tmp