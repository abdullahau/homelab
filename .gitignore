# Deny everything, then allow config explicitly. A new service directory
# tracks nothing until it is listed here.
*
!*/

# Repo meta
!.gitignore
!README.md
!TODO.md
!.env.example

# Compose files and tooling
!*-docker-compose.yml
!docker-manager.sh
!scripts/*.sh
!scripts/pre-commit
!webos/*.sh

# Templates only, never the rendered output
!*.template
!*.example

# Tracked service config
!edge-stack/Caddyfile
!glance/config/*.yml
!glance/assets/user.css
!compose-files/**
!hysteria/README.md

# Hard re-deny: these must never be tracked, whatever the rules above allow.
.env
**/.env
.env.bak*
**/certs/
*.key
*.pem
adguard-home/
mediamtx/mediamtx.yml
hysteria/config.yaml
transmission/settings.json
# Sideload packages and their build scratch. Download or rebuild them;
# see webos/README.md. The build tree carries a README.md of its own, which
# the unanchored "!README.md" above would otherwise pick up.
*.ipk
*.tar.xz
webos/build/
