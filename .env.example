# Copy to .env and fill in every value. NEVER commit .env.

PUID=1000
PGID=1000
TZ=Asia/Dubai

# Adguard
ADGUARD_USERNAME=replace-me
ADGUARD_PASSWORD=replace-me

# Host addresses
HOST_LAN_IP=replace-me
HOST_TS_IP=replace-me
MACHINE_NAME_TS=replace-me

# NVR camera (Tapo)
CAMERA_HOST=replace-me
CAMERA_USER=replace-me
CAMERA_PASSWORD=replace-me

# Cloudflare
TUNNEL_TOKEN=replace-me

# Transmission
TRANSMISSION_USERNAME=replace-me
TRANSMISSION_PASSWORD=replace-me

# Speedtest
SPEEDTEST_KEY=replace-me
SPEEDTEST_NAME=replace-me
SPEEDTEST_EMAIL=replace-me
SPEEDTEST_PASSWORD=replace-me
# Speedtest Tracker API (used by the Glance widget)
SPEEDTEST_API_TOKEN=replace-me

# Beszel
BESZEL_TOKEN=replace-me
BESZEL_KEY=replace-me
BESZEL_USERNAME=replace-me
BESZEL_PASSWORD=replace-me

# Hysteria
HYSTERIA_PASSWORD=replace-me

# Visual DB
VDB_HOST_ID=replace-me
VDB_API_KEY=replace-me
VDB_ENCRYPTION_KEY=replace-me
VDB_TOKEN_SECRET=replace-me

# NocoDB
NC_SMTP_PASSWORD=replace-me
NC_ADMIN_PASSWORD=replace-me
NC_AUTH_JWT_SECRET=replace-me

# Readers
BOOKLORE_PORT=replace-me
MARIADB_PASSWORD=replace-me

# DuckDNS
DUCKDNS_TOKEN=replace-me
DUCKDNS_SUBDOMAIN=replace-me

# IPTV - viniplay
VINIPLAY_SESSION_SECRET=replace-me
